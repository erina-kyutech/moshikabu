# ---- バックエンド (FastAPI) ----
# 株価データの取得先。将来 alphavantage / twelvedata などへ切り替える
MARKET_DATA_PROVIDER=yfinance
# CORS を許可するオリジン（カンマ区切り）。ローカル開発では未設定でOK
CORS_ORIGINS=http://localhost:5173
# 記録（仮想ポートフォリオ・マイルール・デイトレ練習）の保存先。
# 未設定ならサーバー保存は無効になり、ブラウザ内保存だけで動く
DATABASE_URL=

# ---- フロントエンド (Vite) ----
# API のベースURL。同一オリジンに /api がある場合（Vercel）は空でよい
VITE_API_BASE=
